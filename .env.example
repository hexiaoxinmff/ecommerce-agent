# 环境变量示例（第十阶段 P0-4 整理）
#
# 用法：
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# 然后填写真实值。`.env` 已被 .gitignore 排除（`.env` / `.env.local` / `*.key`）。
#
# ⚠️ 硬约束：**真实 API Key 只允许存在于本机 `.env` 或系统环境变量中。**
#    本文件（会进 Git）里的所有 Key 项一律留空，不得填写真实值。
#    前端的环境变量在另一个文件：`frontend/.env.example`（Vite 只读 frontend/ 下的 .env）。
#
# 检查当前配置是否生效：
#   curl http://127.0.0.1:8000/api/health     # 只反映「配置」，不代表上游可用
#
# ---------------------------------------------------------------------------
# 1. LLM Provider（★ 必填：不配置则所有依赖 LLM 的接口返回明确的「未配置」错误）
# ---------------------------------------------------------------------------
# 可选值：bailian（推荐运行环境）| mimo（正式评测基线）
LLM_PROVIDER=bailian

# 单模型锁定。默认 true = 只使用 BAILIAN_MODEL / BAILIAN_PRIMARY_MODEL，
# 不启用模型池自动 fallback。正式评测契约要求保持 true。
LLM_MODEL_LOCK=true

# ---------- 1.1 阿里云百炼（DashScope OpenAI 兼容模式）★ 推荐 ----------
# API Key 的**唯一**来源就是 DASHSCOPE_API_KEY（刻意不提供 BAILIAN_API_KEY 别名，
# 避免同一个 Secret 出现两条读取路径）。
# 申请：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
BAILIAN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-flash
BAILIAN_PRIMARY_MODEL=qwen3.7-flash
BAILIAN_TIMEOUT=30

# 免费额度模型池：仅当 LLM_MODEL_LOCK=false 时才会用到（默认不用）
BAILIAN_FREE_TIER_ONLY=true
# BAILIAN_FALLBACK_MODELS=qwen3.7-flash,qwen-plus

# 注意：百炼的 thinking 已在代码里**物理锁死为 false**（字面量，非配置项），
# 因为其推理链按 output token 计费。刻意不提供任何可覆盖它的环境变量。

# ---------- 1.2 Mimo V2.5 Pro（可选：正式评测基线 Provider）----------
# Clean Baseline v1.1（90.0% EX）使用的 Provider；日常运行不需要它。
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5-pro
# MIMO_TIMEOUT=30

# ---------- 1.3 本地模型（可选，默认关闭）----------
# LOCAL_LLM_BASE_URL=
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_MODEL=

# ---------------------------------------------------------------------------
# 2. 数据文件路径（可选：默认值已指向项目内的相对路径）
# ---------------------------------------------------------------------------
# 业务库（只读访问，由 scripts/init_db.py 生成）
# ECOMMERCE_DB_PATH=db/ecommerce.db
# 应用库（认证 / 会话 / 查询历史，由 scripts/init_auth_db.py 生成）
# APP_DB_PATH=db/app.db
# Few-shot 数据集
# FEWSHOT_DATASET_PATH=data/fewshot/ecommerce_examples.json
#
# Database Profile（Phase 13 跨数据库适配层）：ecommerce_A（默认，db/ecommerce.db）
# 或 ecommerce_B（第二公司演示库 db/ecommerce_v2.db，需先运行 scripts/init_db_v2.py）。
# 未设置时等价于 ecommerce_A，行为与 v1.0 完全一致。
# DB_PROFILE=ecommerce_A

# ---------------------------------------------------------------------------
# 3. 服务与鉴权（可选）
# ---------------------------------------------------------------------------
# 允许的前端来源，逗号分隔。默认 http://localhost:5173。
# ⚠️ 前端 API Base 默认是 http://127.0.0.1:8000，而浏览器同源策略把
#    localhost 与 127.0.0.1 视为**不同 origin**：跨机访问或改端口时请在此显式补充。
# CORS_ORIGINS=http://localhost:5173
# 登录会话有效期（秒），默认 7 天
# AUTH_SESSION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# 4. 实验开关（默认关闭；不要为了"让它跑起来"而打开）
# ---------------------------------------------------------------------------
# E 系列 SQL 生成附加规则（仅作用于 sql_generate 节点）
# SQLGEN_EXTRA_RULES=
