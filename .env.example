# ===== 大模型提供方（LLM_PROVIDER）=====
# 可选值：
#   qwen     -> 通义千问（默认，单个 Key 同时支持对话与 Embedding，最省心）
#   deepseek -> DeepSeek（仅对话，Embedding 仍建议用 qwen）
#   doubao   -> 豆包（字节火山方舟 Ark，OpenAI 兼容）
#   xiaomi   -> 小米 MiMo（OpenAI 兼容）
# 也可以直接填 LLM_BASE_URL + LLM_CHAT_MODEL 接任意 OpenAI 兼容模型
LLM_PROVIDER=qwen

# 你的 API Key（不填则进入“演示模式”：本地 hash 向量 + 模板生成，零成本可跑）
API_KEY=

# ===== 通义千问（默认提供方）=====
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBED_MODEL=text-embedding-v3

# ===== DeepSeek（可选）=====
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ===== 豆包 / 火山方舟 Ark（可选）=====
# 模型 ID 在火山方舟控制台「在线推理」创建接入点后获得，形如 doubao-seed-1-8-251228 或 ep-xxxx
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=doubao-seed-1-8-251228

# ===== 小米 MiMo（可选）=====
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_CHAT_MODEL=mimo-v2.5-pro

# ===== 嵌入层（RAG 检索质量）=====
# 豆包文本 Embedding 已下线、小米无公开文本 Embedding，因此用 doubao/xiaomi 时
# 默认 EMBEDDING_PROVIDER=mock（本地 hash，演示可用但非语义）。
# 若想升级为真实语义检索，可保持下方 qwen 嵌入并单独填通义 Key：
EMBEDDING_PROVIDER=qwen
# 如需独立 Embedding Key（例如对话用豆包、Embedding 用通义），取消下面两行注释并填写：
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-v3

# ===== 检索参数 =====
RETRIEVE_TOP_K=4
CHUNK_SIZE=400
CHUNK_OVERLAP=80
