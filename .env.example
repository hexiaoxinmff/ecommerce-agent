# 配置示例：复制本文件为 .env 后填写实际值（.env 已被 .gitignore 排除，绝不提交）
# 注意：真实 MIMO_API_KEY 只允许存在于本机 .env / 环境变量中，严禁写入代码或 Git。

# 当前 Provider（支持 mimo / bailian，可省略，默认 mimo）
LLM_PROVIDER=mimo

# Mimo V2.5 Pro API（OpenAI-compatible）
# 官方默认（按量付费，见 https://platform.xiaomimimo.com/docs，2026-09 确认）：
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_TIMEOUT=30

# Alibaba Cloud Bailian（阿里云百炼，OpenAI-compatible）
# 启用方式：把上面的 LLM_PROVIDER 改为 bailian
# 低消费默认模型：qwen3.7-flash-2026-07-15
# thinking 已在代码里物理锁死为 false（不可配置），因为其推理链按 output token 计费
# API Key 唯一来源是 DASHSCOPE_API_KEY，刻意不提供 BAILIAN_API_KEY 别名
DASHSCOPE_API_KEY=
BAILIAN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-flash-2026-07-15
BAILIAN_TIMEOUT=30