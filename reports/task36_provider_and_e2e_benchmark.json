  "3_error_classification_design": {
    "new_exception": "LLMInsufficientBalanceError",
    "base_class": "LLMError",
    "inherits_service_unavailable": false,
    "rationale": "If it inherited LLMServiceUnavailableError, isinstance(exc, LLMServiceUnavailableError) would remain True and the 402-vs-5xx strict separation requirement could not be asserted. They are different fault domains.",
    "new_optional_field": {
      "name": "http_status",
      "on": "LLMError.__init__",
      "default": null,
      "backward_compatible": true,
      "purpose": "Carry the upstream HTTP status for diagnostics and benchmark recording."
    },
    "classification_table": [
      {"http": "401/403", "exception": "LLMAuthenticationError", "retried": false, "http_status_field": "401/403"},
      {"http": "402", "exception": "LLMInsufficientBalanceError", "retried": false, "http_status_field": 402},
      {"http": "429", "exception": "LLMRateLimitError", "retried": false, "http_status_field": 429},
      {"http": "500/502/503", "exception": "LLMServiceUnavailableError", "retried": false, "http_status_field": "500/502/503"},
      {"http": "other 4xx", "exception": "LLMServiceUnavailableError", "retried": false, "http_status_field": "original", "note": "existing fallback preserved"},
      {"http": "timeout", "exception": "LLMTimeoutError", "retried": false, "http_status_field": null},
      {"http": "network", "exception": "LLMNetworkError", "retried": true, "retry_count": 2, "http_status_field": null}
    ]
  },

